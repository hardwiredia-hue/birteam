# Desarrollo: SQLite local. En staging y producción se usa PostgreSQL
# (ver deploy/PUBLICAR.md); el script de publicación ajusta el proveedor.
DATABASE_URL="file:./dev.db"

# Clave del endpoint de tareas programadas (/api/tareas): recordatorios y
# vencimiento de la lista de espera. En el servidor va en .env.production
# y en el cron (ver deploy/PUBLICAR.md §Recordatorios).
TAREAS_CLAVE="cualquier-clave-larga-para-desarrollo"

# Notificaciones push (avisos aunque la app esté cerrada). Cada ambiente
# genera su par con `npx web-push generate-vapid-keys` (ver deploy/PUBLICAR.md).
# Sin claves, la app funciona igual pero sin push.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Ingreso con Google (opcional: sin esto el botón no aparece).
# Credenciales OAuth 2.0 de Google Cloud Console (ver deploy/PUBLICAR.md).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# URL pública del ambiente, para la vuelta del OAuth (en el servidor es
# https://birteam.com o https://staging.birteam.com).
URL_PUBLICA=""

# Cobros con Mercado Pago (opcional: sin esto no hay cobro online).
# Aplicación de birteam en Mercado Pago Developers (ver deploy/PUBLICAR.md).
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_WEBHOOK_SECRET=""
# Cifra los tokens de los complejos: 64 caracteres hex (openssl rand -hex 32).
MP_CLAVE_CIFRADO=""
