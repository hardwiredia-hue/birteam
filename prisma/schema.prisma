// birteam — modelo de datos de la fase 1 (ver ESQUEMA.md §4).
//
// Desarrollo: SQLite. Staging y producción: PostgreSQL (deploy/publicar.sh
// cambia el proveedor antes de generar el cliente). Por eso no usamos enums:
// los valores válidos viven en src/lib/constantes.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            String   @id @default(cuid())
  nombre        String
  usuario       String   @unique
  email         String   @unique
  // Nula en cuentas que entran solo con Google (pueden crearse una después).
  hashClave     String?
  // Cuenta de Google vinculada (sub de OpenID).
  googleId      String?  @unique
  telefono      String?
  bio           String?
  avatarUrl     String?
  // Ubicación: ciudad elegida con autocompletado + coordenadas.
  ciudad        String?
  provincia     String?
  pais          String   @default("AR")
  latitud       Float?
  longitud      Float?
  radioKm       Int      @default(15)
  // 'oscuro' (por defecto) | 'claro'
  tema          String   @default("oscuro")
  // 'USUARIO' | 'ADMIN'
  rol           String   @default("USUARIO")
  // 'JUGADOR' | 'CANCHA' (dueño de cancha: puede publicar canchas para alquilar)
  tipoCuenta    String   @default("JUGADOR")
  // Suscripción de dueño de cancha: activa mientras esta fecha esté en el futuro.
  suscripcionHasta DateTime?
  // Datos del dueño de cancha: referencia pública y titular real.
  complejoNombre String?
  complejoDireccion String?
  cuit           String?
  // 'PENDIENTE' (sin comprobante) | 'EN_REVISION' | 'VERIFICADA' | 'RECHAZADA'
  verificacion   String   @default("PENDIENTE")
  // Comprobante de titularidad (constancia de AFIP o factura de servicio).
  verificacionDocUrl String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  sesiones         Sesion[]
  deportes         UsuarioDeporte[]
  gruposCreados    Grupo[]           @relation("creadorGrupo")
  membresias       MiembroGrupo[]
  partidosOrg      Partido[]         @relation("organizador")
  partidosCoOrg    Partido[]         @relation("coOrganizador")
  participaciones  Participacion[]
  mensajes         Mensaje[]
  mensajesRecibidos Mensaje[]        @relation("mensajesRecibidos")
  notificaciones   Notificacion[]
  denunciasHechas  Denuncia[]        @relation("denunciante")
  denunciasContra  Denuncia[]        @relation("denunciado")
  bloqueosHechos   Bloqueo[]         @relation("bloqueador")
  bloqueosContra   Bloqueo[]         @relation("bloqueado")
  jugadas          Jugada[]
  comentarios      ComentarioJugada[]
  meGusta          MeGustaJugada[]
  siguiendo        Seguimiento[]      @relation("seguidor")
  seguidores       Seguimiento[]      @relation("seguido")
  torneosOrganizados Torneo[]         @relation("torneosOrganizados")
  equiposCapitan   EquipoTorneo[]     @relation("equiposCapitan")
  tokensRecuperacion TokenRecuperacion[]
  suscripcionesPush SuscripcionPush[]
  canchas          Cancha[]
  lugares          LugarGuardado[]
  reservas         Reserva[]
  resenasCancha    ResenaCancha[]
}

// Lugares donde el usuario ya organizó: se eligen de una y guardan el contacto.
model LugarGuardado {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nombre    String
  direccion String?
  telefono  String?
  ultimaVez DateTime @default(now())

  @@unique([usuarioId, nombre])
}


// Ajustes del sitio editables desde el backoffice (marca: logo, ícono, favicon).
model Ajuste {
  clave         String   @id
  valor         String
  actualizadoEn DateTime @updatedAt
}

// Cancha publicada para alquilar (solo dueños con suscripción activa).
model Cancha {
  id            String   @id @default(cuid())
  duenoId       String
  dueno         Usuario  @relation(fields: [duenoId], references: [id], onDelete: Cascade)
  nombre        String
  descripcion   String?
  deporteId     String
  deporte       Deporte  @relation(fields: [deporteId], references: [id])
  direccion     String
  ciudad        String?
  provincia     String?
  pais          String   @default("AR")
  latitud       Float?
  longitud      Float?
  precioPorHora Float?
  telefono      String?
  // Fotos: JSON con nombres de archivo subidos (igual que Jugada).
  fotos         String   @default("[]")
  // Días de la semana en que la cancha está disponible (JSON, 0=domingo … 6=sábado).
  diasDisponibles String @default("[0,1,2,3,4,5,6]")
  // Horario de los turnos: de horaApertura a horaCierre (horas enteras, 24 = medianoche),
  // en turnos de duracionTurno minutos (60, 90 o 120).
  horaApertura  Int      @default(9)
  horaCierre    Int      @default(23)
  duracionTurno Int      @default(60)
  // Sin reservas online la cancha se publica igual, pero se reserva por teléfono.
  reservasOnline Boolean @default(true)
  // El dueño la puede pausar sin borrarla.
  activa        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  partidos Partido[]
  reservas Reserva[]
  ofertas  OfertaTurno[]
  resenas  ResenaCancha[]

  @@index([deporteId, activa])
}

// Un turno de cancha. El jugador lo solicita, el dueño lo confirma o rechaza.
// El dueño también bloquea turnos (reservas telefónicas, mantenimiento).
model Reserva {
  id          String    @id @default(cuid())
  canchaId    String
  cancha      Cancha    @relation(fields: [canchaId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // Día y hora en horario argentino ("2026-10-09", "21:00"); inicio es el instante exacto.
  fecha       String
  hora        String
  inicio      DateTime
  duracion    Int       @default(60)
  // 'SOLICITADA' | 'CONFIRMADA' | 'RECHAZADA' | 'CANCELADA' | 'VENCIDA' | 'BLOQUEO'
  estado      String    @default("SOLICITADA")
  // Precio al momento de pedirla (se paga en el complejo).
  precio      Float?
  nota        String?
  motivo      String?
  // "canchaId|fecha|hora" mientras el turno está tomado, null al liberarse:
  // la base impide que dos reservas activas ocupen el mismo turno.
  ocupa       String?   @unique
  // Una solicitud sin respuesta vence y libera el turno.
  venceEn     DateTime?
  recordadaEn DateTime?
  partidoId   String?
  // Pedida desde el Radar: el precio es el de la oferta.
  ofertaId    String?
  creadoEn    DateTime  @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([canchaId, fecha])
  @@index([usuarioId, inicio])
  @@index([estado, venceEn])
}

// Radar de turnos libres: el dueño ofrece con descuento un turno que está libre.
// Solo se muestra mientras el turno siga libre de verdad y no haya empezado.
model OfertaTurno {
  id             String   @id @default(cuid())
  canchaId       String
  cancha         Cancha   @relation(fields: [canchaId], references: [id], onDelete: Cascade)
  fecha          String
  hora           String
  inicio         DateTime
  precioOriginal Float?
  precioOferta   Float
  creadoEn       DateTime @default(now())

  @@unique([canchaId, fecha, hora])
  @@index([inicio])
}

// Reseña de una cancha. Solo la deja quien jugó ahí (turno confirmado o
// partido en esa cancha ya jugado); una por persona, editable. El dueño responde.
model ResenaCancha {
  id            String    @id @default(cuid())
  canchaId      String
  cancha        Cancha    @relation(fields: [canchaId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  puntaje       Int
  texto         String?
  respuesta     String?
  respondidaEn  DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  @@unique([canchaId, usuarioId])
  @@index([canchaId, creadoEn])
}

// Desafío entre grupos (buscador de rivales). Con rival: va dirigido a ese
// grupo. Sin rival: queda publicado y lo acepta el primer grupo del mismo
// deporte. Al aceptarse se arma el partido e invita a los dos grupos.
model Desafio {
  id             String    @id @default(cuid())
  deporteId      String
  deporte        Deporte   @relation(fields: [deporteId], references: [id])
  retadorId      String
  retador        Grupo     @relation("desafioRetador", fields: [retadorId], references: [id], onDelete: Cascade)
  rivalId        String?
  rival          Grupo?    @relation("desafioRival", fields: [rivalId], references: [id], onDelete: Cascade)
  creadorId      String
  fecha          DateTime
  lugarNombre    String
  direccion      String?
  canchaId       String?
  ciudad         String?
  jugadoresPorLado Int     @default(5)
  nivel          String?
  mensaje        String?
  // 'PENDIENTE' | 'ACEPTADO' | 'RECHAZADO' | 'CANCELADO'
  estado         String    @default("PENDIENTE")
  partidoId      String?
  respondidoEn   DateTime?
  creadoEn       DateTime  @default(now())

  @@index([deporteId, estado, fecha])
  @@index([retadorId])
  @@index([rivalId])
}

// Suscripción del navegador a notificaciones push (una por dispositivo).
model SuscripcionPush {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  creadoEn  DateTime @default(now())

  @@index([usuarioId])
}

// Registro con Google a medio camino: la cuenta se crea recién cuando el
// usuario completa sus datos (@usuario, deportes, ciudad, términos).
model TokenGoogle {
  id        String   @id @default(cuid())
  token     String   @unique
  googleId  String
  email     String
  nombre    String
  foto      String?
  expiraEn  DateTime
  creadoEn  DateTime @default(now())
}

model TokenRecuperacion {
  id        String    @id @default(cuid())
  token     String    @unique
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEn  DateTime
  usadoEn   DateTime?
  creadoEn  DateTime  @default(now())

  @@index([usuarioId, creadoEn])
}

model Sesion {
  id        String   @id @default(cuid())
  token     String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEn  DateTime
  creadoEn  DateTime @default(now())

  @@index([usuarioId])
}

model Deporte {
  id     String @id @default(cuid())
  nombre String @unique
  slug   String @unique
  orden  Int    @default(0)

  usuarios UsuarioDeporte[]
  grupos   Grupo[]
  partidos Partido[]
  torneos  Torneo[]
  canchas  Cancha[]
  desafios Desafio[]
}

model UsuarioDeporte {
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  deporteId String
  deporte   Deporte @relation(fields: [deporteId], references: [id], onDelete: Cascade)
  principal Boolean @default(false)
  posicion  String?
  // 'INICIAL' | 'INTERMEDIO' | 'AVANZADO' | 'COMPETITIVO' (autodeclarado)
  nivel     String?

  @@id([usuarioId, deporteId])
}

model Grupo {
  id              String   @id @default(cuid())
  nombre          String
  slug            String   @unique
  descripcion     String?
  fotoUrl         String?
  deporteId       String
  deporte         Deporte  @relation(fields: [deporteId], references: [id])
  ciudad          String?
  provincia       String?
  pais            String   @default("AR")
  latitud         Float?
  longitud        Float?
  // Token del link de invitación (compartir por WhatsApp).
  tokenInvitacion String   @unique @default(cuid())
  // Visible en Explorar con botón "Sumarme". Cerrado = solo por link.
  abierto         Boolean  @default(true)
  creadorId       String
  creador         Usuario  @relation("creadorGrupo", fields: [creadorId], references: [id])
  creadoEn        DateTime @default(now())

  miembros MiembroGrupo[]
  partidos Partido[]
  mensajes Mensaje[]
  desafiosEnviados  Desafio[] @relation("desafioRetador")
  desafiosRecibidos Desafio[] @relation("desafioRival")
}

model MiembroGrupo {
  grupoId   String
  grupo     Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // 'ADMIN' | 'MIEMBRO'
  rol       String   @default("MIEMBRO")
  unidoEn   DateTime @default(now())

  @@id([grupoId, usuarioId])
}

model Partido {
  id                String    @id @default(cuid())
  deporteId         String
  deporte           Deporte   @relation(fields: [deporteId], references: [id])
  grupoId           String?
  grupo             Grupo?    @relation(fields: [grupoId], references: [id])
  organizadorId     String
  organizador       Usuario   @relation("organizador", fields: [organizadorId], references: [id])
  coOrganizadorId   String?
  coOrganizador     Usuario?  @relation("coOrganizador", fields: [coOrganizadorId], references: [id])
  fecha             DateTime
  duracionMin       Int       @default(60)
  recurrenteSemanal Boolean   @default(false)
  lugarNombre       String
  direccion         String?
  // Teléfono o contacto de la cancha, para reservas y consultas.
  lugarTelefono     String?
  // Cancha publicada elegida como sede (si la hay).
  canchaId          String?
  cancha            Cancha?   @relation(fields: [canchaId], references: [id], onDelete: SetNull)
  // Nivel sugerido para sumarse (null = cualquier nivel).
  nivel             String?
  ciudad            String?
  provincia         String?
  pais              String    @default("AR")
  latitud           Float?
  longitud          Float?
  cupo              Int
  minimo            Int       @default(2)
  costoPorJugador   Float?
  moneda            String    @default("ARS")
  // 'GRUPO' (solo mi grupo) | 'ABIERTO' (visible a cercanos)
  visibilidad       String    @default("GRUPO")
  // 'ARMANDOSE' | 'CONFIRMADO' | 'JUGADO' | 'CANCELADO' (ver reglas en ESQUEMA.md §3.5)
  estado            String    @default("ARMANDOSE")
  resultado         String?
  notas             String?
  // Token de la vista pública (link de WhatsApp).
  tokenPublico      String    @unique @default(cuid())
  creadoEn          DateTime  @default(now())
  actualizadoEn     DateTime  @updatedAt

  participaciones Participacion[]
  mensajes        Mensaje[]

  @@index([fecha])
  @@index([grupoId])
  @@index([visibilidad, estado, fecha])
}

model Participacion {
  id                 String    @id @default(cuid())
  partidoId          String
  partido            Partido   @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  usuarioId          String
  usuario            Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // 'VOY' | 'TALVEZ' | 'NOVOY' | 'ESPERA' | 'INVITADO'
  estado             String
  // Posición en la lista de espera (1 = primero).
  ordenEspera        Int?
  // Cuando se libera un lugar: vencimiento de la invitación (2 h).
  invitacionExpiraEn DateTime?
  pago               Boolean   @default(false)
  // Pasar lista post-partido: null = sin registrar.
  asistio            Boolean?
  creadoEn           DateTime  @default(now())
  actualizadoEn      DateTime  @updatedAt

  @@unique([partidoId, usuarioId])
  @@index([usuarioId])
}

model Mensaje {
  id             String    @id @default(cuid())
  partidoId      String?
  partido        Partido?  @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  grupoId        String?
  grupo          Grupo?    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  // Mensaje directo: va a una persona en vez de a un partido o grupo.
  destinatarioId String?
  destinatario   Usuario?  @relation("mensajesRecibidos", fields: [destinatarioId], references: [id], onDelete: Cascade)
  leidoEn        DateTime?
  autorId        String
  autor          Usuario   @relation(fields: [autorId], references: [id], onDelete: Cascade)
  texto          String
  creadoEn       DateTime  @default(now())

  @@index([partidoId, creadoEn])
  @@index([grupoId, creadoEn])
  @@index([destinatarioId, leidoEn])
  @@index([autorId, destinatarioId, creadoEn])
}

model Notificacion {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // 'INVITACION' | 'LUGAR_LIBERADO' | 'RECORDATORIO' | 'RECONFIRMA' | 'PARTIDO_CAMBIO' | 'PARTIDO_CANCELADO'
  tipo      String
  titulo    String
  cuerpo    String?
  url       String?
  expiraEn  DateTime?
  leidaEn   DateTime?
  creadoEn  DateTime  @default(now())

  @@index([usuarioId, leidaEn, creadoEn])
}

model Denuncia {
  id            String   @id @default(cuid())
  denuncianteId String
  denunciante   Usuario  @relation("denunciante", fields: [denuncianteId], references: [id])
  denunciadoId  String?
  denunciado    Usuario? @relation("denunciado", fields: [denunciadoId], references: [id])
  partidoId     String?
  motivo        String
  detalle       String?
  // 'PENDIENTE' | 'RESUELTA' | 'DESCARTADA'
  estado        String   @default("PENDIENTE")
  creadoEn      DateTime @default(now())
}

model Bloqueo {
  bloqueadorId String
  bloqueador   Usuario  @relation("bloqueador", fields: [bloqueadorId], references: [id], onDelete: Cascade)
  bloqueadoId  String
  bloqueado    Usuario  @relation("bloqueado", fields: [bloqueadoId], references: [id], onDelete: Cascade)
  creadoEn     DateTime @default(now())

  @@id([bloqueadorId, bloqueadoId])
}

// ---------- Torneos: la pieza de COMPETIR ----------

model Torneo {
  id           String   @id @default(cuid())
  nombre       String
  descripcion  String?
  deporteId    String
  deporte      Deporte  @relation(fields: [deporteId], references: [id])
  organizadorId String
  organizador  Usuario  @relation("torneosOrganizados", fields: [organizadorId], references: [id])
  ciudad       String?
  provincia    String?
  // 'INSCRIPCION' | 'EN_JUEGO' | 'TERMINADO'
  estado       String   @default("INSCRIPCION")
  maxEquipos   Int      @default(8)
  // Link publico para convocar equipos sin cuenta. Opcional para poder
  // agregarse sobre tablas con filas; la siembra rellena los que falten.
  tokenPublico String?  @unique @default(cuid())
  creadoEn     DateTime @default(now())

  equipos  EquipoTorneo[]
  partidos PartidoTorneo[]

  @@index([deporteId, estado])
}

model EquipoTorneo {
  id        String   @id @default(cuid())
  torneoId  String
  torneo    Torneo   @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  nombre    String
  capitanId String
  capitan   Usuario  @relation("equiposCapitan", fields: [capitanId], references: [id])
  creadoEn  DateTime @default(now())

  deLocal     PartidoTorneo[] @relation("local")
  deVisitante PartidoTorneo[] @relation("visitante")

  @@unique([torneoId, nombre])
  @@unique([torneoId, capitanId])
}

model PartidoTorneo {
  id             String    @id @default(cuid())
  torneoId       String
  torneo         Torneo    @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  ronda          Int
  localId        String
  local          EquipoTorneo @relation("local", fields: [localId], references: [id], onDelete: Cascade)
  visitanteId    String
  visitante      EquipoTorneo @relation("visitante", fields: [visitanteId], references: [id], onDelete: Cascade)
  golesLocal     Int?
  golesVisitante Int?
  jugadoEn       DateTime?

  @@index([torneoId, ronda])
}

// ---------- Jugadas: la parte social (ESQUEMA.md §3.8, fase 2) ----------

model Jugada {
  id        String   @id @default(cuid())
  autorId   String
  autor     Usuario  @relation(fields: [autorId], references: [id], onDelete: Cascade)
  // Atada a lo que pasa de verdad en birteam: partido, torneo o cancha.
  partidoId String?
  grupoId   String?
  torneoId  String?
  canchaId  String?
  texto     String?
  // Nombres de archivo subidos, como JSON (SQLite no tiene arrays).
  fotos     String   @default("[]")
  // Clip de video (URL en /api/archivos), para el feed vertical.
  videoUrl  String?
  // Video por link externo (YouTube, TikTok, Instagram, Vimeo).
  videoExternoUrl String?
  creadoEn  DateTime @default(now())

  comentarios ComentarioJugada[]
  meGusta     MeGustaJugada[]

  @@index([autorId, creadoEn])
  @@index([grupoId, creadoEn])
  @@index([partidoId, creadoEn])
}

model Seguimiento {
  seguidorId String
  seguidor   Usuario  @relation("seguidor", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguidoId  String
  seguido    Usuario  @relation("seguido", fields: [seguidoId], references: [id], onDelete: Cascade)
  creadoEn   DateTime @default(now())

  @@id([seguidorId, seguidoId])
  @@index([seguidoId])
}

model ComentarioJugada {
  id       String   @id @default(cuid())
  jugadaId String
  jugada   Jugada   @relation(fields: [jugadaId], references: [id], onDelete: Cascade)
  autorId  String
  autor    Usuario  @relation(fields: [autorId], references: [id], onDelete: Cascade)
  texto    String
  creadoEn DateTime @default(now())

  @@index([jugadaId, creadoEn])
}

model MeGustaJugada {
  jugadaId  String
  jugada    Jugada   @relation(fields: [jugadaId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creadoEn  DateTime @default(now())

  @@id([jugadaId, usuarioId])
}

// ---------- Geografía (catálogo para el autocompletado de ciudad) ----------

model Pais {
  codigo     String      @id // ISO-3166-1 alfa-2, ej. "AR"
  nombre     String
  provincias Provincia[]
}

model Provincia {
  id         String   @id @default(cuid())
  nombre     String
  codigo     String? // ISO-3166-2, ej. "AR-B"
  paisCodigo String
  pais       Pais     @relation(fields: [paisCodigo], references: [codigo], onDelete: Cascade)
  latitud    Float?
  longitud   Float?
  ciudades   Ciudad[]

  @@unique([paisCodigo, nombre])
}

model Ciudad {
  id          String    @id @default(cuid())
  nombre      String
  // Nombre normalizado (minúsculas, sin tildes) para buscar en cualquier base.
  nombreNorm  String
  provinciaId String
  provincia   Provincia @relation(fields: [provinciaId], references: [id], onDelete: Cascade)
  latitud     Float?
  longitud    Float?

  @@unique([provinciaId, nombre])
  @@index([nombreNorm])
}
